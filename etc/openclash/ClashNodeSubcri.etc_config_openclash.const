	option enabled '1'
	option group 'nameserver'
	option type 'udp'
	option ip '127.0.0.1'
	option port '7874'
	option interface 'Disable'
	option direct_nameserver '0'
	option node_resolve '0'
	option specific_group 'Disable'
	option disable_ipv6 '0'

config rule_provider_config
	option enabled '1'
	option interval '86400'
	option config 'all'
	list rule_name '放行规则-lhie1(建议置顶并直连)'
	option group '🎯 全球直连'
	option position '0'

config rule_provider_config
	option enabled '1'
	option interval '86400'
	option config 'all'
	option group '🎯 全球直连'
	option position '0'
	list rule_name '国内IP白名单(By lhie1)'
	list rule_name '国内域名白名单(By lhie1)'
