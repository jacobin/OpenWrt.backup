config rule_provider_config
	option enabled '1'
	option interval '86400'
	option config 'all'
	list rule_name '放行规则-lhie1(建议置顶并直连)'
	option group '🎯 全球直连'
	option position '0'

config rule_provider_config
	option enabled '1'
	option interval '86400'
	option config 'all'
	option group '🎯 全球直连'
	option position '0'
	list rule_name 'ChinaCompanyIp'
	list rule_name 'ChinaDomain'
	list rule_name 'ChinaIp(By ACL4SSR)'
	list rule_name 'ChinaMedia'
	list rule_name '国内IP白名单(By lhie1)'
	list rule_name '国内域名白名单(By lhie1)'
	list rule_name '微软服务'

config rule_provider_config
	option enabled '1'
	option interval '86400'
	option config 'all'
	list rule_name '国外常用网站合集(By lhie1)'
	list rule_name 'YouTube(By lhie1)'
	list rule_name 'Google'
	option position '0'
	option group '♻️ 自动选择'

config openclash 'config'
	option proxy_port '7892'
	option tproxy_port '7895'
	option mixed_port '7893'
	option socks_port '7891'
	option http_port '7890'
	option dns_port '7874'
	option update '0'
	option dashboard_forward_ssl '0'
	option ipv6_enable '0'
	option ipv6_dns '0'
	option enable_custom_clash_rules '0'
	option enable_redirect_dns '1'
	option servers_if_update '0'
	option disable_masq_cache '1'
	option servers_update '0'
	option proxy_mode 'rule'
	option intranet_allowed '1'
	option disable_udp_quic '1'
	option operation_mode 'fake-ip'
	option filter_aaaa_dns '0'
	option small_flash_memory '0'
	option custom_fakeip_filter '0'
	option custom_host '0'
	option custom_name_policy '0'
	option append_wan_dns '0'
	option stream_auto_select '0'
	option bypass_gateway_compatible '0'
	option github_address_mod '0'
	option router_self_proxy '1'
	option release_branch 'master'
	option dashboard_type 'Official'
	option yacd_type 'Meta'
	option append_default_dns '0'
	option enable_respect_rules '0'
	option geo_custom_url 'https://testingcf.jsdelivr.net/gh/alecthw/mmdb_china_ip_list@release/lite/Country.mmdb'
	option chnr_custom_url 'https://ispip.clang.cn/all_cn.txt'
	option chnr6_custom_url 'https://ispip.clang.cn/all_cn_ipv6.txt'
	option core_version 'linux-amd64'
	option default_resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option disable_quic_go_gso '0'
	option china_ip_route '1'
	option geo_update_week_time '1'
	option geo_update_day_time '0'
	option chnr_update_week_time '1'
	option chnr_update_day_time '0'
	option auto_restart '0'
	option auto_restart_week_time '1'
	option auto_restart_day_time '0'
	option fakeip_range '0'
	option find_process_mode '0'
	option enable_meta_sniffer '1'
	option enable_meta_sniffer_pure_ip '1'
	option enable_meta_sniffer_custom '0'
	option core_type 'Meta'
	option dnsmasq_noresolv '0'
	option dnsmasq_resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option auto_update '1'
	option geo_auto_update '1'
	option geoip_auto_update '1'
	option geoip_update_week_time '2'
	option geoip_update_day_time '0'
	option geoip_custom_url 'https://testingcf.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geoip.dat'
	option geosite_auto_update '1'
	option geosite_update_week_time '3'
	option geosite_update_day_time '0'
	option geosite_custom_url 'https://testingcf.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat'
	option geoasn_auto_update '1'
	option geoasn_update_week_time '4'
	option geoasn_update_day_time '0'
	option geoasn_custom_url 'https://testingcf.jsdelivr.net/gh/xishang0128/geoip@release/GeoLite2-ASN.mmdb'
	option chnr_auto_update '1'
	option enable_custom_domain_dns_server '1'
	option custom_domain_dns_server '114.114.114.114'
	option enable_custom_dns '1'
	option rule_source '1'
	option enable_rule_proxy '1'
	option enable_tcp_concurrent '1'
	option enable_unified_delay '1'
	option enable_geoip_dat '1'
	option other_rule_auto_update '1'
	option other_rule_update_week_time '5'
	option other_rule_update_day_time '0'
	option cn_port '7090'
	option dashboard_password '123456'
	option log_size '102400'
	option log_level 'error'
	option config_auto_update_mode '1'
	option config_update_interval '120'
	option en_mode 'fake-ip-tun'
	option stack_type 'mixed'
	option enable '1'
	option delay_start '10'
	option skip_safe_path_check '1'
	option skip_proxy_address '1'
	list intranet_allowed_wan_name 'eth1'
	option lan_interface_name 'eth0'
	option interface_name 'eth1'
	option tolerance '100'
	option urltest_interval_mod '300'
	option urltest_address_mod 'https://cp.cloudflare.com/generate_204'
	option store_fakeip '1'
	option custom_fallback_filter '1'
	option global_client_fingerprint 'chrome'
	option geodata_loader 'standard'
