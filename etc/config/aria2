
config aria2 'main'
	option config_dir '/var/etc/aria2'
	option file_allocation 'none'
	list header ''
	list extra_settings ''
	option dir '/etc/openclash/New folder'
	option disk_cache '20M'
	option rpc_auth_method 'user_pass'
	option rpc_passwd 'password'
	option user 'aria2'
	option rpc_user 'aria2'
	option enable_dht 'true'
	option bt_enable_lpd 'true'
	option follow_torrent 'true'
	option rpc_listen_port '6800'
	option save_session_interval '35'
	option max_connection_per_server '2'
	option enable_log 'true'
	option log_level 'notice'
	option enabled '0'

