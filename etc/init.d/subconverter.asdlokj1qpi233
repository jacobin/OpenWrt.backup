#!/bin/sh /etc/rc.common
START=99

start(){
    kill -9 $(pgrep -f subconverter.asdlokj1qpi233/subconverter)
    cd /etc/subconverter.asdlokj1qpi233
    /etc/subconverter.asdlokj1qpi233/subconverter > /dev/null 2>&1 &
}

stop(){
    kill -9 $(pgrep -f subconverter.asdlokj1qpi233/subconverter)
}

restart(){
    kill -9 $(pgrep -f subconverter.asdlokj1qpi233/subconverter)
    cd /etc/subconverter.asdlokj1qpi233
    /etc/subconverter.asdlokj1qpi233/subconverter > /dev/null 2>&1 &
}
