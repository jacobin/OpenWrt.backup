function url_decode() {
    echo "$@" \
        | sed -E 's/%([0-9a-fA-F]{2})/\\x\1/g;s/\+/ /g'
}


cat "NNN.txt" | while read line || [ -n "$line" ];
do
    printf "  - {"

    input_string=${line}
    # Save the current IFS value
    old_ifs="$IFS"
    IFS='/@:?=&#'
    # Read the string into an array
    read -ra elements <<< "$input_string"
    # Restore the old IFS value
    IFS="$old_ifs"

    # https://www.baeldung.com/linux/string-split-many-delimiters
    # https://stackoverflow.com/questions/6723426/looping-over-arrays-printing-both-index-and-value
    for i in "${!elements[@]}"; do
        # trojan://y8DvPRQfz@163.177.46.183:28113?allowInsecure=1&peer=download.windowsupdate.com#IEPL+%C2%B7+%E6%97%A5%E6%9C%ACJP+%C2%B7+23+%C2%B7+%E6%B7%B1%E6%B8%AFIEPL
        #   # 0   trojan
        #   # 1
        #   # 2
        #   # 3   y8DvPRQfz
        #   # 4   163.177.46.183
        #   # 5   28113
        #   # 6   allowInsecure
        #   # 7   1
        #   # 8   peer
        #   # 9   download.windowsupdate.com
        #   # 10  IEPL+%C2%B7+%E6%97%A5%E6%9C%ACJP+%C2%B7+23+%C2%B7+%E6%B7%B1%E6%B8%AFIEPL
        case "$i" in
        0)  printf "type: %s, " "${elements[$i]}"
            ;;
        3)  printf "password: %s, " "${elements[$i]}"
            ;;
        4)  printf  "server: %s, " "${elements[$i]}"
            ;;
        5)  printf  "port: %s, " "${elements[$i]}"
            ;;
        7)  if [[ "${elements[$i]}" == "1" ]]; then
                verify="true"
            else
                veriry="false"
            fi
            printf  "skip-cert-verify: %s, " "${verify}"
            ;;
        10) name=${elements[$i]}
            EscAdd="$(echo $name | sed 's/+/%2B/g')"
            name2="$(url_decode $EscAdd)"
            echo -n -e "name: "$name2
            ;;
        *) ;;
        esac
    done

    printf "}\n"
done >> OOO.yaml
