fnExtractStringBetweenAB YYYY_MM \
    "$(wget -q -O- https://github.com//sharkDoor/vpn-free-nodes/tree/master/node-list/ | grep ',\"contentType\":\"directory\"}],\"templateDirectorySuggestionUrl\"' | sed 's/{\"name\":\"/\n{\"name\":\"/g' | grep ',\"contentType\":\"directory\"}],\"templateDirectorySuggestionUrl\"' | sed -n 1p)" \
        '"path":"node-list/' \
        '","contentType":"directory"'

wget "https://github.com//sharkDoor/vpn-free-nodes/tree/master/node-list/${YYYY_MM}" -OQQQ.html -q
cat QQQ.html | grep "日" | grep "时" | grep "分" | grep '"contentType":"file"}],"templateDirectorySuggestionUrl"' | sed 's/{"name":"/\n{"name":"/g' | grep '.md","contentType":"file"}],"templateDirectorySuggestionUrl"' | sed 's/,/\n/g' | sed -n 1p > LLL.html



fnExtractStringBetweenAB TIME_FName "$(cat LLL.html)" '{"name":"' '.md"'

#   echo [${TIME_FName}]
#   TIME_FName=`echo $TIME_FName | xargs`
#   echo [${TIME_FName}]

#   echo https://raw.githubusercontent.com/sharkDoor/vpn-free-nodes/refs/heads/master/node-list/${YYYY_MM}/${TIME_FName}.md

wget -q -OMMM.txt https://raw.githubusercontent.com/sharkDoor/vpn-free-nodes/refs/heads/master/node-list/${YYYY_MM}/${TIME_FName}.md

tail -n +3 "MMM.txt" | while read line || [ -n "$line" ];
do
    node=$(echo ${line} | cut "-d|" -f 7)
    echo ${node}
done > NNN.txt

#    # trojan://y8DvPRQfz@163.177.46.220:28175?allowInsecure=1&peer=ctldl.windowsupdate.com#IEPL+·+美国US+·+A250+·+Netflix美国+·+ChatGPT解锁+·+沪港IEPL
